{%- comment -%} Cart line items, shared by the cart drawer and the cart page. {%- endcomment -%}
<ul class="cart-items" role="list" data-cart-items>
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}" data-product-id="{{ item.product_id }}">
      <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', widths: '150, 300' }}
        {%- endif -%}
      </a>
      <div class="cart-item__details">
        {%- if item.vendor != blank -%}<span class="cart-item__vendor">{{ item.vendor | escape }}</span>{%- endif -%}
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <ul class="cart-item__options" role="list">
            {%- for option in item.options_with_values -%}
              <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <span class="cart-item__options">{{ property.first | escape }}: {{ property.last | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <span class="cart-item__options">{{ item.selling_plan_allocation.selling_plan.name | escape }}</span>
        {%- endif -%}
        <div class="cart-item__price">
          {%- if item.original_price != item.final_price -%}
            <s class="price__compare">{{ item.original_price | money }}</s> {{ item.final_price | money }}
          {%- else -%}
            {{ item.final_price | money }}
          {%- endif -%}
        </div>
        {%- if item.line_level_discount_allocations != blank -%}
          <ul class="cart-item__discount" role="list">
            {%- for discount in item.line_level_discount_allocations -%}
              <li>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="cart-item__actions">
          <div class="quantity quantity--small" data-quantity>
            <button type="button" data-qty-change="-1" aria-label="{{ 'cart.general.decrease' | t: title: item.product.title | escape }}">−</button>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %} step="{{ item.variant.quantity_rule.increment | default: 1 }}" aria-label="{{ 'cart.general.quantity_for' | t: title: item.product.title | escape }}" data-line-quantity="{{ forloop.index }}">
            <button type="button" data-qty-change="1" aria-label="{{ 'cart.general.increase' | t: title: item.product.title | escape }}">+</button>
          </div>
          <a href="{{ item.url_to_remove }}" class="cart-item__remove" data-line-remove="{{ forloop.index }}">{{ 'cart.general.remove' | t }}<span class="visually-hidden"> {{ item.product.title | escape }}</span></a>
        </div>
        <p class="product-form__error" role="alert" data-line-error hidden></p>
      </div>
      {%- if show_line_total -%}
        <div class="cart-item__total">{{ item.final_line_price | money }}</div>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
