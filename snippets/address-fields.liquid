<div class="contact__form-grid">
  <div class="field"><label for="AddressFirstName_{{ prefix }}">{{ 'customer.addresses.first_name' | t }}</label><input type="text" id="AddressFirstName_{{ prefix }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
  <div class="field"><label for="AddressLastName_{{ prefix }}">{{ 'customer.addresses.last_name' | t }}</label><input type="text" id="AddressLastName_{{ prefix }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
  <div class="field field--full"><label for="AddressCompany_{{ prefix }}">{{ 'customer.addresses.company' | t }}</label><input type="text" id="AddressCompany_{{ prefix }}" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
  <div class="field field--full"><label for="AddressAddress1_{{ prefix }}">{{ 'customer.addresses.address1' | t }}</label><input type="text" id="AddressAddress1_{{ prefix }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
  <div class="field field--full"><label for="AddressAddress2_{{ prefix }}">{{ 'customer.addresses.address2' | t }}</label><input type="text" id="AddressAddress2_{{ prefix }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
  <div class="field"><label for="AddressCity_{{ prefix }}">{{ 'customer.addresses.city' | t }}</label><input type="text" id="AddressCity_{{ prefix }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
  <div class="field"><label for="AddressZip_{{ prefix }}">{{ 'customer.addresses.zip' | t }}</label><input type="text" id="AddressZip_{{ prefix }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" autocapitalize="characters"></div>
  <div class="field"><label for="AddressCountry_{{ prefix }}">{{ 'customer.addresses.country' | t }}</label><select id="AddressCountry_{{ prefix }}" class="select" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select></div>
  <div class="field"><label for="AddressProvince_{{ prefix }}">{{ 'customer.addresses.province' | t }}</label><input type="text" id="AddressProvince_{{ prefix }}" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></div>
  <div class="field field--full"><label for="AddressPhone_{{ prefix }}">{{ 'customer.addresses.phone' | t }}</label><input type="tel" id="AddressPhone_{{ prefix }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
  <label class="facet__option field--full" style="margin-bottom:1rem"><input type="checkbox" id="AddressDefault_{{ prefix }}" name="address[default]" value="1"{% if form.set_as_default_checkbox %} checked{% endif %}> <span>{{ 'customer.addresses.set_default' | t }}</span></label>
</div>
