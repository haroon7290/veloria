{%- liquid
  assign s = section.settings
  assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | strip
  assign has_any = false
  if settings.delivery_options != blank or settings.delivery_dispatch != blank or settings.returns_details != blank or settings.protection_details != blank
    assign has_any = true
  endif
-%}
{%- if has_any -%}
<section class="section delivery-info section--{{ s.background }}" style="--pt: {{ s.padding_top | times: 0.6 }}rem; --pb: {{ s.padding_bottom | times: 0.6 }}rem; --pt-d: {{ s.padding_top }}rem; --pb-d: {{ s.padding_bottom }}rem;">
  <div class="page-width">
    <div class="section-header section-header--split reveal">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ s.heading | escape }}</h2>
      </div>
      {%- if settings.delivery_page != blank -%}
        <div class="section-header__actions">
          <a href="{{ settings.delivery_page.url }}" class="link-arrow"><span>{{ s.link_label | escape }}</span>{% render 'icon', name: 'arrow-right' %}</a>
        </div>
      {%- endif -%}
    </div>
    <div class="delivery-info__grid">
      {%- if settings.delivery_options != blank or settings.delivery_dispatch != blank -%}
        <div class="delivery-info__col reveal">
          <span class="delivery-info__icon">{% render 'icon', name: 'truck' %}</span>
          <h3 class="delivery-info__title">{{ 'products.delivery.title' | t }}</h3>
          <div class="rte">{{ settings.delivery_options }}{{ settings.delivery_dispatch }}</div>
          {%- if shop.shipping_policy.body != blank -%}<a href="{{ shop.shipping_policy.url }}" class="link-underline small">{%- assign sp_fallback = 'products.delivery.shipping_policy' | t -%}{{ shop.shipping_policy.title | default: sp_fallback | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if settings.returns_details != blank -%}
        <div class="delivery-info__col reveal" style="--reveal-delay: 90ms">
          <span class="delivery-info__icon">{% render 'icon', name: 'return' %}</span>
          <h3 class="delivery-info__title">{{ 'products.delivery.returns' | t }}</h3>
          <div class="rte">{{ settings.returns_details }}</div>
          {%- if shop.refund_policy.body != blank -%}<a href="{{ shop.refund_policy.url }}" class="link-underline small">{%- assign rp_fallback = 'products.delivery.refund_policy' | t -%}{{ shop.refund_policy.title | default: rp_fallback | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if settings.protection_details != blank -%}
        <div class="delivery-info__col reveal" style="--reveal-delay: 180ms">
          <span class="delivery-info__icon">{% render 'icon', name: 'shield' %}</span>
          <h3 class="delivery-info__title">{{ 'products.delivery.protection' | t }}</h3>
          <div class="rte">{{ settings.protection_details }}</div>
          {%- if wa != blank -%}
            {%- assign wa_msg = settings.whatsapp_message | append: ' ' | append: product.title | url_encode | replace: '+', '%20' -%}
            <a href="https://wa.me/{{ wa }}?text={{ wa_msg }}" class="link-underline small" target="_blank" rel="noopener">{{ 'products.product.help_whatsapp' | t }}</a>
          {%- elsif s.contact_page != blank -%}
            <a href="{{ s.contact_page.url }}" class="link-underline small">{{ 'products.product.help_contact' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if s.show_points -%}
      {%- assign pts = s.points | remove: ' ' | split: ',' -%}
      <div class="delivery-info__points">{% render 'trust-points', points: pts, layout: 'row' %}</div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Delivery and returns",
  "class": "section-delivery-info",
  "settings": [
    { "type": "paragraph", "content": "Text comes from Theme settings › Trust and delivery, so it stays the same everywhere. Replace the example times and prices with your real ones." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery, returns and peace of mind" },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "Links to the Delivery page chosen in Theme settings.", "default": "Delivery and returns" },
    { "type": "page", "id": "contact_page", "label": "Contact page", "info": "Used when no WhatsApp number is set." },
    { "type": "checkbox", "id": "show_points", "label": "Show trust icons underneath", "default": false },
    { "type": "text", "id": "points", "label": "Points to show", "default": "3,5,6" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "ivory", "label": "Ivory" }, { "value": "ink", "label": "Black" } ], "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 6 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 6 }
  ],
  "presets": [ { "name": "Delivery and returns" } ]
}
{% endschema %}
