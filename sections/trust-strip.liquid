<section class="trust" aria-label="{{ section.settings.label | escape }}">
  <div class="page-width">
    <ul class="trust__list" role="list" style="--cols: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <li class="trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
          <span class="label">{{ block.settings.title | escape }}</span>
          {%- if block.settings.text != blank -%}<span class="trust__text">{{ block.settings.text | escape }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Shopping with Valoria" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "none", "label": "None" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Lock" }, { "value": "gift", "label": "Gift" }, { "value": "bottle", "label": "Bottle" } ], "default": "none" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "text", "label": "Text", "info": "Only state what your policies support." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "sparkle", "title": "Genuine designer fragrances", "text": "From established fragrance houses" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Powered by Shopify" } }
      ]
    }
  ]
}
{% endschema %}
