<section class="section" style="--pt-d: 3rem;">
  <div class="page-width">
    <div class="contact">
      <div class="contact__details">
        {%- if section.settings.show_store_email and shop.email != blank -%}
          <div class="contact__detail"><span class="label">{{ 'templates.contact.email' | t }}</span><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></div>
        {%- endif -%}
        {%- if section.settings.show_store_phone and shop.phone != blank -%}
          <div class="contact__detail"><span class="label">{{ 'templates.contact.phone' | t }}</span><a href="tel:{{ shop.phone | remove: ' ' }}">{{ shop.phone }}</a></div>
        {%- endif -%}
        {%- if section.settings.show_store_address and shop.address.address1 != blank -%}
          <div class="contact__detail"><span class="label">{{ 'templates.contact.address' | t }}</span>{{ shop.address | format_address }}</div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <div class="contact__detail" {{ block.shopify_attributes }}>
            <span class="label">{{ block.settings.title | escape }}</span>
            <div class="rte">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
        {%- if section.blocks.size == 0 and request.design_mode and shop.email == blank -%}
          <p class="text-secondary">{{ 'sections.contact.add_details' | t }}</p>
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-bottom:1.5rem">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{{ 'templates.contact.form.post_success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="contact__form-grid">
            <div class="field">
              <label for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
              <input id="ContactForm-name" type="text" name="contact[{{ 'templates.contact.form.name' | t }}]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="field">
              <label for="ContactForm-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
              <input id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </div>
            <div class="field">
              <label for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
              <input id="ContactForm-phone" type="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="field">
              <label for="ContactForm-order">{{ 'templates.contact.form.order' | t }}</label>
              <input id="ContactForm-order" type="text" name="contact[{{ 'templates.contact.form.order' | t }}]">
            </div>
            <div class="field field--full">
              <label for="ContactForm-body">{{ 'templates.contact.form.comment' | t }} <span aria-hidden="true">*</span></label>
              <textarea id="ContactForm-body" name="contact[{{ 'templates.contact.form.comment' | t }}]" required aria-required="true">{{ form.body }}</textarea>
            </div>
          </div>
          <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "checkbox", "id": "show_store_email", "label": "Show store email", "info": "From Settings › Store details.", "default": true },
    { "type": "checkbox", "id": "show_store_phone", "label": "Show store phone", "info": "From Settings › Store details.", "default": true },
    { "type": "checkbox", "id": "show_store_address", "label": "Show store address", "info": "From Settings › Store details. Leave off if this is a private address.", "default": false }
  ],
  "blocks": [
    { "type": "detail", "name": "Contact detail", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Email" }, { "type": "richtext", "id": "text", "label": "Text", "info": "Use your verified business details only." } ] }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
