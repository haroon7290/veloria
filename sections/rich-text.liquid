<section class="section rich-text{% if section.settings.background != 'none' %} section--{{ section.settings.background }}{% endif %}" style="--align: {{ section.settings.alignment }}; --items: {% if section.settings.alignment == 'left' %}flex-start{% else %}center{% endif %}; --pt-d: {{ section.settings.padding }}rem; --pb-d: {{ section.settings.padding }}rem;">
  <div class="page-width">
    <div class="rich-text__inner reveal">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<span class="eyebrow" {{ block.shopify_attributes }} style="margin:0">{{ block.settings.text | escape }}</span>
          {%- when 'heading' -%}<h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}<div class="rte lead" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}<div {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: routes.root_url }}" class="button{% if block.settings.style == 'secondary' %} button--secondary{% endif %}">{{ block.settings.label | escape }}</a></div>{%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [ { "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" } ], "default": "center" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "none", "label": "Paper" }, { "value": "ivory", "label": "Ivory" }, { "value": "cloud", "label": "Light grey" }, { "value": "stone", "label": "Stone" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Black" } ], "default": "none" },
    { "type": "range", "id": "padding", "label": "Vertical space (desktop)", "min": 2, "max": 10, "step": 1, "unit": "rem", "default": 6 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Small heading", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Valoria London" } ] },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" }, { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" } ], "default": "h2" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share something about your store.</p>" } ] },
    { "type": "button", "name": "Button", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Shop now" }, { "type": "url", "id": "link", "label": "Link" }, { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "primary", "label": "Filled" }, { "value": "secondary", "label": "Outline" } ], "default": "primary" } ] }
  ],
  "presets": [ { "name": "Rich text", "blocks": [ { "type": "heading" }, { "type": "text" } ] } ]
}
{% endschema %}
