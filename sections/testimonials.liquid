{%- liquid
  assign live_count = 0
  assign app_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_count = app_count | plus: 1
    elsif block.settings.genuine or request.design_mode
      assign live_count = live_count | plus: 1
    endif
  endfor
-%}
{%- if live_count > 0 or app_count > 0 -%}
<section class="section testimonials section--{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top | times: 0.6 }}rem; --pb: {{ section.settings.padding_bottom | times: 0.6 }}rem; --pt-d: {{ section.settings.padding_top }}rem; --pb-d: {{ section.settings.padding_bottom }}rem;" data-carousel>
  <div class="page-width">
    <div class="section-header section-header--split reveal">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if live_count > 0 -%}
      <div class="carousel-nav">
        <button type="button" class="carousel-nav__btn" data-carousel-prev aria-label="{{ 'general.carousel.previous' | t }}">{% render 'icon', name: 'chevron-left', class: 'icon--small' %}</button>
        <button type="button" class="carousel-nav__btn" data-carousel-next aria-label="{{ 'general.carousel.next' | t }}">{% render 'icon', name: 'chevron-right', class: 'icon--small' %}</button>
      </div>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="testimonials__app" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}
    {%- if live_count > 0 -%}
    <ul class="testimonials__track" role="list" data-carousel-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
        {%- if block.settings.genuine or request.design_mode -%}
          {%- liquid
            assign rp = block.settings.product
            assign initials = ''
            assign name_words = block.settings.name | split: ' '
            for w in name_words limit: 2
              assign letter = w | slice: 0
              assign initials = initials | append: letter
            endfor
          -%}
          <li class="review" {{ block.shopify_attributes }}>
            <figure class="review__card">
              {%- assign has_media = false -%}
              {%- if block.settings.image != blank or rp.featured_media != blank or request.design_mode -%}{%- assign has_media = true -%}{%- endif -%}
              {%- if has_media -%}
              <div class="review__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, 80vw', loading: 'lazy', alt: block.settings.image.alt | default: '' }}
                {%- elsif rp != blank and rp.featured_media -%}
                  {{ rp.featured_media | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, 80vw', loading: 'lazy', alt: rp.title }}
                {%- else -%}
                  {% render 'media-placeholder', label: 'REVIEW_IMAGE', size: '800 × 600 px', tone: 'beige' %}
                {%- endif -%}
                {%- unless block.settings.genuine -%}<span class="badge review__sample">{{ 'sections.testimonials.sample' | t }}</span>{%- endunless -%}
              </div>
              {%- endif -%}
              <div class="review__body">
                {%- if block.settings.rating > 0 -%}
                  <div class="stars" role="img" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}">
                    {%- for i in (1..5) -%}<svg class="star{% if i > block.settings.rating %} star--empty{% endif %}" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7L10 1.5z"/></svg>{%- endfor -%}
                  </div>
                {%- endif -%}
                <blockquote class="review__quote">{{ block.settings.quote | escape | newline_to_br }}</blockquote>
                <figcaption class="review__author">
                  <span class="review__avatar" aria-hidden="true">{{ initials | upcase | slice: 0, 2 }}</span>
                  <span>
                    <span class="review__name">{{ block.settings.name | escape }}</span>
                    {%- if block.settings.detail != blank -%}<span class="review__detail">{{ block.settings.detail | escape }}</span>{%- endif -%}
                  </span>
                </figcaption>
                {%- if rp != blank -%}
                  <a href="{{ rp.url }}" class="review__product">{{ 'sections.testimonials.purchased' | t }} <span>{{ rp.title | escape }}</span></a>
                {%- endif -%}
              </div>
            </figure>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
    {%- if request.design_mode -%}
      <p class="small text-secondary testimonials__note">{{ 'sections.testimonials.editor_note' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Customer feedback",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Customer experiences" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Valoria experience" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "ivory", "label": "Ivory" }, { "value": "cloud", "label": "Light grey" } ], "default": "ivory" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 },
    { "type": "paragraph", "content": "Only reviews marked as genuine appear on your live store. Unmarked reviews show in the Theme Editor only, labelled Sample. UK law (the DMCC Act 2024) bans publishing fake or invented reviews." },
    { "type": "paragraph", "content": "Using a reviews app? Add its block here to show verified reviews from the app." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "checkbox", "id": "genuine", "label": "This is a genuine customer review", "info": "Tick only for real feedback you have permission to publish. Unticked reviews never appear on the live store.", "default": false },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 0, "max": 5, "step": 1, "default": 5, "info": "0 hides the stars." },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Write the customer's words here." },
        { "type": "text", "id": "name", "label": "Customer name", "info": "Use first name and initial only, with their permission.", "default": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "info": "e.g. town, or Verified buyer.", "default": "Verified buyer" },
        { "type": "product", "id": "product", "label": "Product purchased" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "A customer photo (with permission) or product photo. Without one, the purchased product's image is used." }
      ]
    }
  ],
  "presets": [ { "name": "Customer feedback", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
