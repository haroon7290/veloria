<header class="page-header{% if section.settings.center %} page-header--center{% endif %}{% if section.settings.background != 'none' %} section--{{ section.settings.background }}{% endif %}">
  <div class="page-width">
    <div class="page-header__inner">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="margin:0">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.text != blank -%}<div class="lead text-secondary rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "checkbox", "id": "center", "label": "Centre", "default": true },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "none", "label": "Paper" }, { "value": "ivory", "label": "Ivory" }, { "value": "cloud", "label": "Light grey" }, { "value": "stone", "label": "Stone" } ], "default": "none" }
  ],
  "presets": [ { "name": "Page header" } ]
}
{% endschema %}
