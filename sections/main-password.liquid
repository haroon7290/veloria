<div class="page-width not-found" style="min-height:70vh;align-content:center">
  <img src="{{ 'valoria-compact-dark.svg' | asset_url }}" alt="" width="64" height="64">
  <h1>{{ shop.name | escape }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead text-secondary">{{ shop.password_message | escape }}</p>{%- endif -%}
  <div style="width:100%;max-width:31rem">{% render 'newsletter-form', form_id: 'PasswordNewsletter', button_class: '' %}</div>
  <details style="margin-top:2rem">
    <summary class="link" style="cursor:pointer">{{ 'general.password_page.login_link' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field" style="margin-top:1rem"><label for="StorefrontPassword">{{ 'general.password_page.password' | t }}</label><input type="password" name="password" id="StorefrontPassword" autocomplete="current-password" required></div>
      <button type="submit" class="button">{{ 'general.password_page.enter' | t }}</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
