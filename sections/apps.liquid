{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} class="section apps-section section--{{ s.background }}" style="--pt: {{ s.padding_top | times: 0.6 }}rem; --pb: {{ s.padding_bottom | times: 0.6 }}rem; --pt-d: {{ s.padding_top }}rem; --pb-d: {{ s.padding_bottom }}rem;">
  <div class="page-width{% if s.narrow %} page-width--narrow{% endif %}">
    {%- if s.heading != blank and section.blocks.size > 0 -%}
      <div class="section-header section-header--split">
        <div class="section-header__text">
          {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ s.eyebrow | escape }}</p>{%- endif -%}
          <h2>{{ s.heading | escape }}</h2>
        </div>
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <div class="apps-section__block" {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endfor -%}
    {%- if section.blocks.size == 0 -%}
      <p class="editor-note">{{ 'sections.apps.editor' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Apps",
  "class": "section-apps",
  "settings": [
    { "type": "paragraph", "content": "Add app blocks here, for example product reviews from Judge.me, Okendo or Shopify Product Reviews. Hidden from visitors until an app block is added." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow width", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets other links jump here, for example the star rating under the product title links to #reviews.", "default": "reviews" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "ivory", "label": "Ivory" } ], "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 5 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 5 }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "Apps" } ]
}
{% endschema %}
