{%- liquid
  assign s = section.settings
  assign families = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign families = families | plus: 1
    endif
  endfor
  assign show_audience = false
  if s.her_collection != blank or s.him_collection != blank
    assign show_audience = true
  endif
-%}
{%- if families > 0 or request.design_mode -%}
<section class="section finder section--{{ s.background }}" style="--pt: {{ s.padding_top | times: 0.6 }}rem; --pb: {{ s.padding_bottom | times: 0.6 }}rem; --pt-d: {{ s.padding_top }}rem; --pb-d: {{ s.padding_bottom }}rem;" data-finder>
  <div class="page-width">
    <div class="finder__layout">
      <div class="finder__intro reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="finder__lead rte">{{ s.text }}</div>{%- endif -%}
      </div>

      {%- if families > 0 -%}
        <form class="finder__form reveal" data-finder-form novalidate>
          {%- assign step = 0 -%}
          {%- if show_audience -%}
            {%- assign step = step | plus: 1 -%}
            <fieldset class="finder__step">
              <legend class="finder__question"><span class="finder__num" aria-hidden="true">0{{ step }}</span>{{ s.audience_question | escape }}</legend>
              <div class="finder__choices">
                {%- if s.her_collection != blank -%}
                  <label class="choice"><input type="radio" name="audience-{{ section.id }}" value="{{ s.her_collection.handle }}" data-finder-audience data-label="{{ s.her_label | escape }}"><span class="choice__title">{{ s.her_label | escape }}</span></label>
                {%- endif -%}
                {%- if s.him_collection != blank -%}
                  <label class="choice"><input type="radio" name="audience-{{ section.id }}" value="{{ s.him_collection.handle }}" data-finder-audience data-label="{{ s.him_label | escape }}"><span class="choice__title">{{ s.him_label | escape }}</span></label>
                {%- endif -%}
                <label class="choice"><input type="radio" name="audience-{{ section.id }}" value="" data-finder-audience data-label="{{ s.anyone_label | escape }}" checked><span class="choice__title">{{ s.anyone_label | escape }}</span></label>
              </div>
            </fieldset>
          {%- endif -%}

          {%- assign step = step | plus: 1 -%}
          <fieldset class="finder__step">
            <legend class="finder__question"><span class="finder__num" aria-hidden="true">0{{ step }}</span>{{ s.mood_question | escape }}</legend>
            <div class="finder__choices finder__choices--moods">
              {%- for block in section.blocks -%}
                {%- assign c = block.settings.collection -%}
                {%- if c != blank -%}
                  <label class="choice choice--mood" {{ block.shopify_attributes }}>
                    <input type="radio" name="family-{{ section.id }}" value="{{ c.handle }}" data-finder-family data-url="{{ c.url }}" data-title="{{ block.settings.title | default: c.title | escape }}"{% if forloop.first %} required{% endif %}>
                    <span class="choice__title">{{ block.settings.title | default: c.title | escape }}</span>
                    {%- if block.settings.mood != blank -%}<span class="choice__text">{{ block.settings.mood | escape }}</span>{%- endif -%}
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>

          <p class="finder__error" data-finder-error hidden>{{ 'sections.finder.choose' | t }}</p>
          <div class="button-row">
            <button type="submit" class="button">{{ s.button_label | escape }}</button>
          </div>
          <noscript>
            <ul class="finder__fallback" role="list">
              {%- for block in section.blocks -%}
                {%- if block.settings.collection != blank -%}<li><a href="{{ block.settings.collection.url }}">{{ block.settings.title | default: block.settings.collection.title | escape }}</a></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </noscript>
        </form>
      {%- else -%}
        <p class="editor-note">{{ 'sections.finder.editor' | t }}</p>
      {%- endif -%}
    </div>

    <div class="finder__result" data-finder-result hidden tabindex="-1">
      <div class="finder__result-head">
        <div>
          <p class="eyebrow eyebrow--rule">{{ 'sections.finder.result_eyebrow' | t }}</p>
          <h3 class="h2" data-finder-title></h3>
          <p class="finder__note text-secondary" data-finder-note hidden></p>
        </div>
        <div class="finder__result-actions">
          <a href="{{ routes.all_products_collection_url }}" class="link-arrow" data-finder-link><span>{{ 'sections.finder.explore' | t }}</span>{% render 'icon', name: 'arrow-right' %}</a>
          <button type="button" class="link finder__reset" data-finder-reset>{{ 'sections.finder.reset' | t }}</button>
        </div>
      </div>
      <ul class="product-grid product-grid--4" role="list" data-finder-products></ul>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Scent finder",
  "class": "section-finder",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Scent finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your signature" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Two quick questions, and we will show you fragrances from our collection that match your mood.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Reveal my edit" },
    { "type": "header", "content": "Question 1: who is it for" },
    { "type": "paragraph", "content": "Results are narrowed to products that are also in the chosen collection. Leave both collections empty to skip this question." },
    { "type": "text", "id": "audience_question", "label": "Question", "default": "Who is it for?" },
    { "type": "text", "id": "her_label", "label": "First answer", "default": "For her" },
    { "type": "collection", "id": "her_collection", "label": "First answer collection" },
    { "type": "text", "id": "him_label", "label": "Second answer", "default": "For him" },
    { "type": "collection", "id": "him_collection", "label": "Second answer collection" },
    { "type": "text", "id": "anyone_label", "label": "Third answer (no filter)", "default": "For anyone" },
    { "type": "header", "content": "Question 2: mood" },
    { "type": "text", "id": "mood_question", "label": "Question", "default": "Which mood draws you in?" },
    { "type": "paragraph", "content": "Add a Mood block for each scent family collection." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "ivory", "label": "Ivory" }, { "value": "white", "label": "White" }, { "value": "cloud", "label": "Light grey" } ], "default": "ivory" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Answer", "info": "Leave empty to use the collection title." },
        { "type": "text", "id": "mood", "label": "Description", "default": "Bright, clean and effortless" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent finder",
      "blocks": [
        { "type": "mood", "settings": { "title": "Fresh & Citrus", "mood": "Bright, clean and effortless" } },
        { "type": "mood", "settings": { "title": "Floral", "mood": "Petals, powder and softness" } },
        { "type": "mood", "settings": { "title": "Woody", "mood": "Cedar, sandalwood and vetiver" } },
        { "type": "mood", "settings": { "title": "Amber & Spice", "mood": "Warm, resinous and rich" } }
      ]
    }
  ]
}
{% endschema %}
