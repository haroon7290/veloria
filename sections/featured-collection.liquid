{%- liquid
  assign s = section.settings
  assign collection_obj = s.collection
  assign limit = s.products_to_show
  assign use_list = false
  if s.source == 'products' and s.product_list != blank and s.product_list.size > 0
    assign use_list = true
  endif
  assign has_products = false
  if use_list
    assign has_products = true
  elsif collection_obj != blank and collection_obj.products_count > 0
    assign has_products = true
  endif
  assign link_url = s.link | default: collection_obj.url
-%}
{%- if has_products or request.design_mode -%}
<section class="section featured section--{{ s.background }}" style="--pt: {{ s.padding_top | times: 0.6 }}rem; --pb: {{ s.padding_bottom | times: 0.6 }}rem; --pt-d: {{ s.padding_top }}rem; --pb-d: {{ s.padding_bottom }}rem;"{% if s.layout == 'carousel' %} data-carousel{% endif %}>
  <div class="page-width">
    <div class="section-header section-header--{{ s.header_alignment }} reveal">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="section-header__lead rte">{{ s.text }}</div>{%- endif -%}
      </div>
      <div class="section-header__actions">
        {%- if s.layout == 'carousel' -%}
          <div class="carousel-nav">
            <button type="button" class="carousel-nav__btn" data-carousel-prev aria-label="{{ 'general.carousel.previous' | t }}">{% render 'icon', name: 'chevron-left', class: 'icon--small' %}</button>
            <button type="button" class="carousel-nav__btn" data-carousel-next aria-label="{{ 'general.carousel.next' | t }}">{% render 'icon', name: 'chevron-right', class: 'icon--small' %}</button>
          </div>
        {%- endif -%}
        {%- if s.link_label != blank and link_url != blank -%}
          <a class="link-arrow" href="{{ link_url }}"><span>{{ s.link_label | escape }}</span>{% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if has_products -%}
      <ul
        class="product-grid product-grid--{{ s.columns }}{% if s.layout == 'carousel' %} product-grid--carousel{% endif %}"
        role="list"
        {% if s.layout == 'carousel' %}data-carousel-track tabindex="0" aria-label="{{ s.heading | escape }}"{% endif %}
      >
        {%- if use_list -%}
          {%- for product in s.product_list limit: limit -%}
            <li class="reveal" style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 80 }}ms">{% render 'product-card', card_product: product, section_id: section.id, index: forloop.index0, badge_text: s.badge_label %}</li>
          {%- endfor -%}
        {%- else -%}
          {%- for product in collection_obj.products limit: limit -%}
            <li class="reveal" style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 80 }}ms">{% render 'product-card', card_product: product, section_id: section.id, index: forloop.index0, badge_text: s.badge_label %}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- else -%}
      <p class="editor-note">{{ 'sections.featured_collection.choose' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Signature Edit" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover the fragrances that define the Valoria London experience.</p>" },
    { "type": "select", "id": "header_alignment", "label": "Heading alignment", "options": [ { "value": "split", "label": "Left, with link on the right" }, { "value": "center", "label": "Centred" } ], "default": "split" },
    { "type": "header", "content": "Products" },
    { "type": "select", "id": "source", "label": "Show", "options": [ { "value": "collection", "label": "Products from a collection" }, { "value": "products", "label": "Products I choose" } ], "default": "collection" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Products, prices and stock come from this collection." },
    { "type": "product_list", "id": "product_list", "label": "Products", "limit": 12, "info": "Used when Show is set to Products I choose." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "badge_label", "label": "Label on each card", "info": "For example Bestseller. Leave empty for none." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "grid", "label": "Grid" }, { "value": "carousel", "label": "Carousel" } ], "default": "grid" },
    { "type": "select", "id": "columns", "label": "Products per row on desktop", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the edit" },
    { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to the collection." },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "ivory", "label": "Ivory" }, { "value": "cloud", "label": "Light grey" } ], "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}
