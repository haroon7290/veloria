<section class="section wishlist section--{{ section.settings.background }}" style="--pt-d: 4rem; --pb-d: 6rem;" data-wishlist-page>
  <div class="page-width">
    <div class="section-header section-header--center">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="h1">{{ page.title | default: section.settings.heading | escape }}</h1>
        {%- if page.content != blank -%}<div class="section-header__lead rte">{{ page.content }}</div>{%- endif -%}
      </div>
    </div>
    <ul class="product-grid product-grid--4" role="list" data-wishlist-grid></ul>
    <div class="wishlist__empty" data-wishlist-empty hidden>
      <p class="h3">{{ section.settings.empty_heading | escape }}</p>
      <p class="text-secondary">{{ section.settings.empty_text | escape }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ section.settings.button_label | escape }}</a>
    </div>
    <noscript><p class="text-secondary">{{ 'products.wishlist.no_js' | t }}</p></noscript>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "class": "section-wishlist",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Saved for later" },
    { "type": "text", "id": "heading", "label": "Heading (when the page has no title)", "default": "Your wishlist" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Your wishlist is empty" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Tap the heart on any fragrance to save it here." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover fragrances" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "ivory", "label": "Ivory" } ], "default": "white" }
  ]
}
{% endschema %}
