<header class="page-header page-header--center">
  <div class="page-width"><div class="page-header__inner"><h1>{{ section.settings.heading | escape }}</h1></div></div>
</header>
<div class="page-width" style="padding-bottom:6rem">
  <ul class="family-grid family-grid--below family-grid--list" role="list">
    {%- for c in collections -%}
      {%- if c.all_products_count > 0 or section.settings.show_empty -%}
        <li>
          <a href="{{ c.url }}" class="family-card">
            <div class="family-card__media">
              {%- if c.featured_image -%}
                {{ c.featured_image | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {%- liquid
                  assign tone = 'beige'
                  assign k = forloop.index0 | modulo: 2
                  if k == 1
                    assign tone = 'stone'
                  endif
                -%}
                {% render 'media-placeholder', label: 'COLLECTION_IMAGE', size: '900 × 1200 px', tone: tone, word: c.title %}
              {%- endif -%}
            </div>
            <div class="family-card__body">
              <h2 class="family-card__title">{{ c.title | escape }}</h2>
              <span class="family-card__text">{{ 'products.facets.product_count' | t: count: c.all_products_count }}</span>
            </div>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "checkbox", "id": "show_empty", "label": "Show empty collections", "default": false }
  ]
}
{% endschema %}
