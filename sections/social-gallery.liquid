{%- liquid
  assign s = section.settings
  assign with_images = 0
  for block in section.blocks
    if block.settings.image != blank
      assign with_images = with_images | plus: 1
    endif
  endfor
  assign profile = s.profile_url | default: settings.social_instagram
-%}
{%- if with_images > 0 or request.design_mode -%}
<section class="section social-gallery section--{{ s.background }}" style="--pt: {{ s.padding_top | times: 0.6 }}rem; --pb: {{ s.padding_bottom | times: 0.6 }}rem; --pt-d: {{ s.padding_top }}rem; --pb-d: {{ s.padding_bottom }}rem;">
  <div class="page-width">
    <div class="section-header section-header--split reveal">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="section-header__lead rte">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if profile != blank and s.handle != blank -%}
        <div class="section-header__actions">
          <a class="link-arrow" href="{{ profile }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<span>{{ s.handle | escape }}</span></a>
        </div>
      {%- endif -%}
    </div>
    <ul class="social__grid social__grid--{{ s.shape }}" role="list" style="--count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank or request.design_mode -%}
          {%- liquid
            assign n = forloop.index
            assign slot = 'INSTAGRAM_IMAGE_'
            if n < 10
              assign slot = slot | append: '0'
            endif
            assign slot = slot | append: n
            assign href = block.settings.link | default: profile
            assign tone = 'beige'
            if forloop.index0 == 1 or forloop.index0 == 4
              assign tone = 'stone'
            endif
          -%}
          <li class="social__item reveal" style="--reveal-delay: {{ forloop.index0 | times: 70 }}ms" {{ block.shopify_attributes }}>
            {%- if href != blank -%}<a href="{{ href }}" class="social__link"{% if block.settings.link == blank %} target="_blank" rel="noopener"{% endif %}>{%- else -%}<span class="social__link">{%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 17vw, 45vw', loading: 'lazy', alt: block.settings.image.alt | default: '' }}
              {%- else -%}
                {% render 'media-placeholder', label: slot, size: '1080 × 1350 px', tone: tone %}
              {%- endif -%}
            {%- if href != blank -%}<span class="visually-hidden">{{ 'sections.social.open' | t }}</span></a>{%- else -%}</span>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Social gallery",
  "class": "section-social",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Visitors only see this section once at least one image is added." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Instagram" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the world of Valoria" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover the details, moments and inspiration behind Valoria London.</p>" },
    { "type": "text", "id": "handle", "label": "Profile link label", "default": "Follow on Instagram", "info": "For example your @handle." },
    { "type": "url", "id": "profile_url", "label": "Profile link", "info": "Leave empty to use the Instagram link in Theme settings › Social media." },
    { "type": "select", "id": "shape", "label": "Image shape", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" } ], "default": "portrait" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "ivory", "label": "Ivory" } ], "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait 1080 × 1350 px or square 1080 × 1080 px." },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to your profile." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" } ]
    }
  ]
}
{% endschema %}
