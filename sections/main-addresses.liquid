<div class="page-width">
  <div class="customer customer--wide">
    <p><a href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a></p>
    <h1>{{ 'customer.addresses.title' | t }}</h1>
    <div class="account-grid">
      <div>
        {%- paginate customer.addresses by 10 -%}
          {%- for address in customer.addresses -%}
            <div class="address-card">
              {%- if address == customer.default_address -%}<span class="label">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
              {{ address | format_address }}
              <details style="margin-top:1rem">
                <summary class="link" style="cursor:pointer">{{ 'customer.addresses.edit' | t }}</summary>
                {%- form 'customer_address', address -%}
                  {% render 'address-fields', form: form, prefix: address.id %}
                  <button type="submit" class="button">{{ 'customer.addresses.update' | t }}</button>
                {%- endform -%}
              </details>
              <form method="post" action="{{ address.url }}" style="margin-top:.75rem">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="link" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')">{{ 'customer.addresses.delete' | t }}</button>
              </form>
            </div>
          {%- endfor -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      </div>
      <div>
        <h2 class="h3" style="margin-bottom:1rem">{{ 'customer.addresses.add' | t }}</h2>
        {%- form 'customer_address', customer.new_address -%}
          {% render 'address-fields', form: form, prefix: 'new' %}
          <button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{ "name": "Customer addresses", "settings": [] }
{% endschema %}
