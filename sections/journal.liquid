{%- liquid
  assign blog_obj = section.settings.blog
  assign use_blog = false
  if section.settings.source == 'blog' and blog_obj != blank and blog_obj.articles_count > 0
    assign use_blog = true
  endif
-%}
<section class="section{% if section.settings.background != 'none' %} section--{{ section.settings.background }}{% endif %}">
  <div class="page-width">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="margin:0">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <ul class="journal-grid" role="list">
      {%- if use_blog -%}
        {%- for article in blog_obj.articles limit: 3 -%}
          <li class="reveal">
            <a href="{{ article.url }}" class="journal-card">
              <div class="journal-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: '' }}
                {%- else -%}
                  {% render 'media-placeholder', label: 'JOURNAL_IMAGE', size: '1800 × 1200 px (3:2)', tone: 'beige', word: article.title %}
                {%- endif -%}
              </div>
              <span class="label text-secondary">{{ article.published_at | time_tag: format: 'date' }}</span>
              <span class="journal-card__title">{{ article.title | escape }}</span>
              {%- if article.excerpt != blank -%}<span class="journal-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <li class="reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="journal-card">{%- else -%}<div class="journal-card">{%- endif -%}
              <div class="journal-card__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'media-placeholder', label: 'JOURNAL_IMAGE', size: '1800 × 1200 px (3:2)', tone: 'beige' %}
                {%- endif -%}
              </div>
              {%- if block.settings.label != blank -%}<span class="label text-secondary">{{ block.settings.label | escape }}</span>{%- endif -%}
              <span class="journal-card__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Fragrance education",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fragrance, explained" },
    { "type": "select", "id": "source", "label": "Content", "options": [ { "value": "blocks", "label": "Cards below" }, { "value": "blog", "label": "Latest articles from a blog" } ], "default": "blocks" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "none", "label": "Paper" }, { "value": "ivory", "label": "Ivory" }, { "value": "cloud", "label": "Light grey" }, { "value": "white", "label": "White" } ], "default": "none" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Guide" },
        { "type": "text", "id": "title", "label": "Title", "default": "Article title" },
        { "type": "url", "id": "link", "label": "Link", "info": "Link to the article or page." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "art", "label": "Built-in illustration", "options": [ { "value": "journal-notes", "label": "Notes pyramid" }, { "value": "journal-edp-edt", "label": "Two bottles" }, { "value": "journal-where-to-apply", "label": "Pulse point" } ], "default": "journal-notes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance education",
      "blocks": [
        { "type": "card", "settings": { "title": "Understanding top, heart and base notes" } },
        { "type": "card", "settings": { "title": "Eau de parfum vs eau de toilette" } },
        { "type": "card", "settings": { "title": "Where to apply fragrance, and why" } }
      ]
    }
  ]
}
{% endschema %}
