<section class="section{% if section.settings.background != 'none' %} section--{{ section.settings.background }}{% endif %}" style="--pt-d: 3rem;">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-bottom:2rem">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="accordion">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            <h3 class="faq__group-title h3" {{ block.shopify_attributes }} style="padding-top:{% unless forloop.first %}3rem{% else %}0{% endunless %};padding-bottom:1rem">{{ block.settings.title | escape }}</h3>
          {%- when 'question' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }} {% render 'icon', name: 'plus' %}</summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- assign questions = section.blocks | where: 'type', 'question' -%}
{%- if questions.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for q in questions -%}
        {
          "@type": "Question",
          "name": {{ q.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ q.settings.answer | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "none", "label": "Paper" }, { "value": "ivory", "label": "Ivory" }, { "value": "white", "label": "White" }, { "value": "cloud", "label": "Light grey" } ], "default": "none" }
  ],
  "blocks": [
    { "type": "group", "name": "Topic heading", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Orders" } ] },
    { "type": "question", "name": "Question", "settings": [ { "type": "text", "id": "question", "label": "Question", "default": "Question" }, { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" } ] }
  ],
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "question" } ] } ]
}
{% endschema %}
