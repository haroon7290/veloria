{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 -%}
<section class="section values section--{{ s.background }}" style="--pt: {{ s.padding_top | times: 0.6 }}rem; --pb: {{ s.padding_bottom | times: 0.6 }}rem; --pt-d: {{ s.padding_top }}rem; --pb-d: {{ s.padding_bottom }}rem;">
  <div class="page-width">
    <div class="section-header section-header--center reveal">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--rule">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="section-header__lead rte">{{ s.text }}</div>{%- endif -%}
      </div>
    </div>
    <ol class="values__list" role="list" style="--cols: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="values__item reveal" style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
          {%- case s.marker -%}
            {%- when 'numbers' -%}
              <span class="values__marker values__marker--number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {%- when 'icons' -%}
              {%- if block.settings.icon != 'none' -%}<span class="values__marker">{% render 'icon', name: block.settings.icon %}</span>{%- endif -%}
          {%- endcase -%}
          {%- if block.settings.title != blank -%}<h3 class="values__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="values__text rte">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Values",
  "class": "section-values",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Why Valoria London" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Considered in every detail" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "marker", "label": "Marker", "options": [ { "value": "numbers", "label": "Numbers" }, { "value": "icons", "label": "Line icons" }, { "value": "none", "label": "None" } ], "default": "numbers" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "ivory", "label": "Ivory" }, { "value": "cloud", "label": "Light grey" }, { "value": "ink", "label": "Black" } ], "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 10, "step": 1, "unit": "rem", "default": 7 },
    { "type": "paragraph", "content": "Keep each point to what you can stand behind. Avoid claims about ingredients, longevity or origin unless you can evidence them." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon (when markers are icons)", "options": [ { "value": "none", "label": "None" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "bottle", "label": "Bottle" }, { "value": "gift", "label": "Gift" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" } ], "default": "sparkle" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values",
      "blocks": [
        { "type": "value", "settings": { "title": "Thoughtfully selected fragrances", "text": "<p>A considered edit of designer fragrances, chosen for character rather than volume.</p>" } },
        { "type": "value", "settings": { "title": "Elegance in every detail", "text": "<p>From first browse to checkout, every step is designed to feel calm, clear and unhurried.</p>" } },
        { "type": "value", "settings": { "title": "A signature for every occasion", "text": "<p>Fresh daytime scents to rich evening compositions, organised so you can find yours with ease.</p>" } }
      ]
    }
  ]
}
{% endschema %}
