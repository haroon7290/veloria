<div class="page-width">
  <div class="customer">
    <h1>{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label><input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" value="{{ form.first_name }}"></div>
      <div class="field"><label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label><input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" value="{{ form.last_name }}"></div>
      <div class="field"><label for="RegisterEmail">{{ 'customer.register.email' | t }}</label><input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="RegisterPassword">{{ 'customer.register.password' | t }}</label><input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required></div>
      <label class="facet__option" style="margin-bottom:1.5rem"><input type="checkbox" name="customer[accepts_marketing]" value="true"> <span>{{ 'customer.register.marketing' | t }}</span></label>
      <button type="submit" class="button">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
    <div class="customer__links"><a href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a></div>
  </div>
</div>
{% schema %}
{ "name": "Customer register", "settings": [] }
{% endschema %}
