{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{%- assign gc_value = gift_card.initial_value | money -%}{{ 'gift_cards.issued.title' | t: value: gc_value }} – {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width not-found">
      <img src="{{ 'valoria-logo-dark.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="200" height="42">
      <h1>{{ 'gift_cards.issued.subtext' | t }}</h1>
      <p class="h2">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p class="form-message form-message--error">{{ 'gift_cards.issued.expired' | t }}</p>{%- endif -%}
      {%- if gift_card.expires_on -%}<p class="text-secondary">{%- assign gc_exp = gift_card.expires_on | date: '%d %B %Y' -%}{{ 'gift_cards.issued.expires_on' | t: expires_on: gc_exp }}</p>{%- endif -%}
      <p class="label">{{ 'gift_cards.issued.code' | t }}</p>
      <p class="h3" style="letter-spacing:.1em">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <div class="button-row" style="justify-content:center">
        <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy"></a>{%- endif -%}
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
