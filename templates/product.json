{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "show_vendor": true,
            "show_concentration": true,
            "show_rating": true,
            "reviews_anchor": "reviews",
            "show_wishlist": true
          }
        },
        "highlights": {
          "type": "highlights",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {
            "show_savings": true,
            "show_installments": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "style": "pills"
          }
        },
        "stock": {
          "type": "stock",
          "settings": {
            "low_stock": 3
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true
          }
        },
        "popularity": {
          "type": "popularity",
          "settings": {
            "text": "A Valoria bestseller",
            "tag": "bestseller",
            "collection": "bestsellers",
            "icon": "sparkle"
          }
        },
        "trust": {
          "type": "trust",
          "settings": {
            "points": "1,3,6",
            "layout": "row"
          }
        },
        "multibuy": {
          "type": "multibuy",
          "settings": {}
        },
        "help": {
          "type": "help",
          "settings": {
            "text": "Need advice choosing?",
            "contact_page": "contact"
          }
        },
        "timeline": {
          "type": "timeline",
          "settings": {}
        }
      },
      "block_order": [
        "heading",
        "price",
        "popularity",
        "highlights",
        "variant_picker",
        "stock",
        "multibuy",
        "buy_buttons",
        "timeline",
        "trust",
        "help"
      ],
      "settings": {
        "enable_zoom": true,
        "image_fit": "cover",
        "sticky_atc": true,
        "gallery_layout": "below",
        "image_ratio": "portrait",
        "info_position": "right",
        "sticky_desktop": true
      }
    },
    "related": {
      "type": "related-products",
      "settings": {
        "eyebrow": "Same category",
        "limit": 4,
        "heading": "You might also like"
      }
    },
    "recently_viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "limit": 6
      }
    },
    "similar": {
      "type": "product-carousel",
      "settings": {
        "source": "vendor",
        "eyebrow": "Same brand",
        "heading": "More from this brand",
        "limit": 4,
        "background": "ivory"
      }
    },
    "fbt": {
      "type": "product-fbt",
      "settings": {
        "eyebrow": "Complete the ritual",
        "heading": "Frequently bought together",
        "limit": 2,
        "use_complementary": true,
        "prefer_multibuy": true,
        "background": "white",
        "padding_top": 6,
        "padding_bottom": 6
      }
    },
    "product_reviews": {
      "type": "product-reviews",
      "settings": {
        "eyebrow": "Reviews",
        "heading": "Customer reviews",
        "per_page": 6,
        "share_label": "Share your experience",
        "share_page": "contact",
        "show_empty": true,
        "empty_heading": "No reviews yet",
        "empty_text": "Tried this fragrance? We'd love to hear what you think.",
        "anchor": "reviews",
        "background": "ivory",
        "padding_top": 6,
        "padding_bottom": 6
      }
    },
    "tabs": {
      "type": "product-tabs",
      "settings": {
        "show_description": true,
        "show_notes": true,
        "top_hint": "The opening impression",
        "heart_hint": "The character of the fragrance",
        "base_hint": "The lasting foundation",
        "show_details": true,
        "show_how": true,
        "show_delivery": true,
        "show_faqs": true,
        "background": "ivory",
        "padding_top": 5,
        "padding_bottom": 6
      }
    }
  },
  "order": [
    "main",
    "tabs",
    "fbt",
    "product_reviews",
    "related",
    "similar",
    "recently_viewed"
  ]
}