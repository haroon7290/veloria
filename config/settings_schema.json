  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_house_fonts",
        "label": "t:settings_schema.typography.settings.use_house_fonts.label",
        "info": "t:settings_schema.typography.settings.use_house_fonts.info",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings_schema.typography.settings.heading_font",
        "default": "serif"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings_schema.typography.settings.body_font",
        "default": "sans_serif_n4"
      },
      {
        "type": "select",
        "id": "product_name_font",
        "label": "t:settings_schema.typography.settings.product_name_font.label",
        "options": [
          {
            "value": "body",
            "label": "t:settings_schema.typography.settings.product_name_font.options.body"
          },
          {
            "value": "heading",
            "label": "t:settings_schema.typography.settings.product_name_font.options.heading"
          }
        ],
        "default": "body"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.heading_scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.body_scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1680,
        "step": 20,
        "unit": "px",
        "label": "t:settings_schema.layout.settings.page_width",
        "default": 1440
      },
      {
        "type": "checkbox",
        "id": "animations",
        "label": "t:settings_schema.layout.settings.animations",
        "default": true
      },
      {
        "type": "header",
        "content": "Motion"
      },
      {
        "type": "select",
        "id": "reveal_style",
        "label": "Scroll reveal",
        "options": [
          {
            "value": "fade-up",
            "label": "Fade and rise"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "none",
            "label": "Off"
          }
        ],
        "default": "fade-up",
        "info": "Headings, text and images ease in as they scroll into view."
      },
      {
        "type": "checkbox",
        "id": "hero_zoom",
        "label": "Slow image zoom when the hero loads",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "hover_zoom",
        "label": "Gentle image zoom on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_transitions",
        "label": "Smooth fade between pages",
        "info": "Uses the browser's built-in page transitions where supported. Has no effect in other browsers.",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "All motion is switched off automatically for visitors who ask their device to reduce motion."
      }
    ]
  },
