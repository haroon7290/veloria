          {
            "value": "cloud",
            "label": "t:settings_schema.products.settings.card_image_background.options.cloud"
          },
          {
            "value": "white",
            "label": "t:settings_schema.products.settings.card_image_background.options.white"
          }
        ],
        "default": "cloud"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "t:settings_schema.products.settings.card_show_vendor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "t:settings_schema.products.settings.card_show_second_image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "t:settings_schema.products.settings.card_quick_add",
        "default": true
      },
      {
        "type": "text",
        "id": "size_option_names",
        "label": "t:settings_schema.products.settings.size_option_names.label",
        "info": "t:settings_schema.products.settings.size_option_names.info",
        "default": "size,volume,ml,bottle size"
      },
      {
        "type": "checkbox",
        "id": "card_show_family",
        "label": "Show fragrance family on product cards",
        "info": "From the custom.fragrance_family product metafield.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show star rating on product cards",
        "info": "Only appears when a reviews app fills Shopify's standard product rating metafield.",
        "default": true
      },
      {
        "type": "text",
        "id": "card_badge_tag",
        "label": "Product tag for the label badge",
        "info": "Products with this tag show the label below on their card, for example tag 'bestseller'.",
        "default": "bestseller"
      },
      {
        "type": "text",
        "id": "card_badge_label",
        "label": "Label badge text",
        "default": "Bestseller"
      },
      {
        "type": "select",
        "id": "card_sale_badge",
        "label": "Sale badge on product cards",
        "options": [
          {
            "value": "percent",
            "label": "Percentage, for example −30%"
          },
          {
            "value": "text",
            "label": "The word Sale"
          }
        ],
        "default": "percent"
      },
      {
        "type": "header",
        "content": "Wishlist"
      },
      {
        "type": "page",
        "id": "wishlist_page",
        "label": "Wishlist page",
        "info": "Create a page called Wishlist using the 'wishlist' template, then choose it here. Adds a heart to the header and product pages. Saved items stay in the shopper's browser."
      }
    ]
  },
