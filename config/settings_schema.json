        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show star rating on product cards",
        "info": "Only appears when a reviews app fills Shopify's standard product rating metafield.",
        "default": true
      },
      {
        "type": "text",
        "id": "card_badge_tag",
        "label": "Product tag for the label badge",
